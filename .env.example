# Copy to .env and fill in. NEVER commit .env.
CRM_DB=Server=localhost;User Id=snapcrm_ro;Password=REPLACE_ME;Initial Catalog=SnapCrm_Db;TrustServerCertificate=True
FOOD_DB_READONLY=Server=localhost;User Id=snapcrm_ro;Password=REPLACE_ME;Initial Catalog=FoodOrder_Db;TrustServerCertificate=True;ApplicationIntent=ReadOnly

# Master safety switch — keep false until staging tests pass.
SENDING_ENABLED=false

# 32+ random chars; signs unsubscribe links.
UNSUBSCRIBE_SECRET=REPLACE_ME_LONG_RANDOM

PUBLIC_BASE_URL=https://crm.snap-food.eu
FROM_EMAIL=hallo@snap-food.eu

# Brevo (email service provider)
BREVO_API_KEY=REPLACE_ME
BREVO_WEBHOOK_SECRET=REPLACE_ME
